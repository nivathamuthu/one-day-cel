# Copy to backend/.env for local use. Never commit the real .env file.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (works from Render).
# Leave empty locally to store surprises as JSON files in ../data/surprises instead.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Optional but recommended: Supabase → Project Settings → Database → SSL Configuration → Download certificate.
# Paste the PEM contents (multi-line is fine on Render). When empty, traffic is encrypted but the server certificate is not verified.
DATABASE_CA_CERT=

# Exact website origins allowed to call the API, comma separated. Required in production.
ALLOWED_ORIGINS=https://birthday-moments-sigma.vercel.app,http://localhost:5173

# Public frontend address, used when a share link is created from localhost.
PUBLIC_BASE=https://birthday-moments-sigma.vercel.app

# Surprises one visitor may create per 15 minutes.
RATE_LIMIT_MAX=30

# Render sets PORT automatically. Locally the API defaults to 3001.
# PORT=3001
